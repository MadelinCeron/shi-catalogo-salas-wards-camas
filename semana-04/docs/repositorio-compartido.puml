@startuml

title Semana 04 - Integración mediante repositorio de datos compartido

actor "Usuario hospitalario" as User

package "Micro-HIS Catálogo de salas, wards y camas" {

    package "Presentation" {
        component "WardBedView" as View
        component "WardBedController" as Controller
    }

    package "Application" {
        component "CreateWardAndBed" as UseCase
        interface "WardRepository" as WardRepo
        interface "BedRepository" as BedRepo
    }

    package "Domain" {
        component "Ward" as Ward
        component "Bed" as Bed
        component "BedStatus" as Status
    }

    package "Persistence" {
        component "PdoWardRepository" as PdoWard
        component "PdoBedRepository" as PdoBed
        component "InMemoryWardRepository" as MemoryWard
        component "InMemoryBedRepository" as MemoryBed
    }
}

database "Repositorio de datos compartido" as SharedDB

component "Módulo de admisión" as Admission
component "Módulo de traslados y altas" as Transfers
component "Dashboard de ocupación" as Dashboard

User --> View
View --> Controller
Controller --> UseCase

UseCase --> Ward
UseCase --> Bed
Bed --> Status

UseCase --> WardRepo
UseCase --> BedRepo

PdoWard ..|> WardRepo
PdoBed ..|> BedRepo

MemoryWard ..|> WardRepo
MemoryBed ..|> BedRepo

PdoWard --> SharedDB
PdoBed --> SharedDB

Admission --> SharedDB
Transfers --> SharedDB
Dashboard --> SharedDB

note bottom of SharedDB
Un repositorio de datos compartido permitiría
que módulos relacionados consulten información
consistente sobre salas y camas.

El acceso del módulo permanece encapsulado
mediante las interfaces Repository.
end note

@enduml